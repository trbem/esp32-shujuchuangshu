# Must match Sensor Dashboard Configuration > Telemetry collector API key.
TELEMETRY_API_KEY=replace-with-a-long-random-secret
# Set both only for the Cloudflare Tunnel deployment.  The dashboard hostname
# is protected by Cloudflare Access; the ingest hostname is for ESP32 HTTPS.
REMOTE_DASHBOARD_HOST=dashboard.example.com
REMOTE_INGEST_HOST=ingest.example.com
